# ==========================================
# FraudShield Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME=FraudShield
API_V1_STR=/api/v1
PROJECT_NAME=FraudShield AI Fraud Detection Platform

# Security
SECRET_KEY=generate-a-secure-32-byte-hex-key-here-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fraudshield_user
POSTGRES_PASSWORD=fraudshield_secret_password
POSTGRES_DB=fraudshield_db
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://fraudshield_user:fraudshield_secret_password@localhost:5432/fraudshield_db
SQLALCHEMY_SYNC_DATABASE_URI=postgresql+psycopg://fraudshield_user:fraudshield_secret_password@localhost:5432/fraudshield_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=FraudShield_Detection

# Machine Learning Artifacts
MODEL_ARTIFACTS_DIR=ml/artifacts
CHAMPION_MODEL_VERSION=v1.0.0

# Initial Admin Setup
FIRST_SUPERUSER_EMAIL=admin@fraudshield.io
FIRST_SUPERUSER_PASSWORD=AdminPassword123!
FIRST_SUPERUSER_NAME=System Administrator

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Observability
PROMETHEUS_METRICS_ENABLED=True

